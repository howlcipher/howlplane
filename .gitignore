# Ignore local environment variables to protect personal data
.env
.env.*

# Ignore Google API credentials
credentials.json
token.json
client_secret.json
*.json

# Tracked JSON schemas are not credentials
!config/schemas/*.schema.json
!schemas/*.schema.json
!contracts/howl/*.schema.json
# Vendored HowlInstinct receipt contract and routing evaluation cases are tracked
!contracts/howlinstinct/*.schema.json
!evals/resource_routing/*.json

# Tracked run-artifact example fixtures are not credentials
!examples/runs/*.json
!dogfood/historical-reasoning-evidence/runs/*.json
!tests/fixtures/*.json
!.dogfood/mission_state.json
# Redacted Factory status published from the host (HOWL-011). Not a credential.
!factory/status/remote-snapshot.json
# Finite-queue example used by the remote admit doc. Not a credential.
!factory/examples/*.json

# Generated skills index is tracked
!.agents/skills.json

# Devin project config is tracked; local overrides are not
!.devin/config.json
.devin/config.local.json
.devin/mcp_config.local.json

# Ignore synced personal Google Docs
personal_docs/

# Ignore local vector databases
.chromadb/
.chroma/

# Python caching and environments
__pycache__/
*.pyc
venv/
.pytest_cache/
.coverage
coverage.out

# Go binaries and builds
/howlplane
/howlplane.exe
/ai_installer
/ai_installer.exe
/installer
dist/
/gh_*_linux_amd64/

# Python build output and package metadata
/build/
*.egg-info/

# Local telemetry state
.telemetry/

# Auto-generated docs site mirror (built fresh by `make docs` / CI, deployed to
# gh-pages). docs/index.html, docs/app.js, docs/styles.css, docs/favicon.svg,
# and docs/og-image.jpg are hand-authored frontend source with no generation
# step (see tests/test_frontend.py) and stay tracked.
docs/api/
docs/documentation/
docs/.agents/
docs/assets/
docs/AGENTS.md
docs/GEMINI.md
docs/CLAUDE.md
docs/change_log.md
docs/index.md
docs/_layouts/
docs/_config.yml
/docs/.build-tmp/

# Campaign-owned isolated historical worktrees (cleaned after evidence persists)
/.worktrees/

# One-off scratch output at the repo root (logs, patches, archives from debugging sessions)
/*.log
/*.diff
/*.zip
/logs/
/.task_runs/
/.dogfood_runs/
/task_*.yaml
/output/

# Ignore personal user profile and PII
USER_PROFILE.md
pii.yaml
