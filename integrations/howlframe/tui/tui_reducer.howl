; HowlPlane TUI reducer (ADR 0009): one deterministic state transition.
; stdin:  {"schema":"howlplane.tui_step/v1","state":{...},"event":{...},"config":{...}}
; stdout: {"schema":"howlplane.tui_step_result/v1","ok":true,"state":{...},"view":[...],
;          "prompt":"...","intents":[...]}
; Runs with no capability grant. Intents are proposals; the host executes only
; the ones in its closed table (inventory_refresh, route_preview,
; run_objective, cancel, quit).
(cli_app
  (use "tui_core.howl" as core)
  (let (raw (read_stdin))
    (try_let (step (parse_json Step raw))
      (catch e
        (do
          (print (encode_json (dict ("schema" "howlplane.tui_step_result/v1") ("ok" false)
                                    ("code" "MALFORMED_STEP") ("diagnostic" e))))
          (exit 2)))
      (if (!= (map_get step "schema") "howlplane.tui_step/v1")
        (do
          (print (encode_json (dict ("schema" "howlplane.tui_step_result/v1") ("ok" false)
                                    ("code" "UNSUPPORTED_STEP_SCHEMA") ("diagnostic" "expected howlplane.tui_step/v1"))))
          (exit 2))
        (let (state (map_get step "state"))
          (let (event (map_get step "event"))
            (let (config (map_get step "config"))
              (let (kind (map_get event "type"))
                (let (intents (list))
                  ; Notices accumulate until the operator types again.
                  (let (notices (if (or (= kind "line") (is_nil (map_get state "notices"))) (list) (map_get state "notices")))
                    (let (mode (map_get state "mode"))
                      (do
                        (when (is_nil mode) (set mode "idle"))
                        (cond
                          ; Free text, a /command, or the answer to a confirmation.
                          ((= kind "line")
                            (let (text (str_trim (to_string (map_get event "text"))))
                              (cond
                                ((and (= mode "confirm") (= text "/quit"))
                                  (do
                                    (set mode "idle")
                                    (append intents (dict ("kind" "quit")))))
                                ((= mode "confirm")
                                  (if (or (= (to_lower text) "y") (= (to_lower text) "yes"))
                                    (do
                                      (set mode "running")
                                      (map_delete state "outcome")
                                      (map_delete state "progress")
                                      (append intents (dict ("kind" "run_objective")
                                                            ("objective" (map_get state "objective"))
                                                            ("resource_id" (map_get state "explicit_resource")))))
                                    (do
                                      (set mode "idle")
                                      (append notices "Run not started."))))
                                ((= mode "running")
                                  (if (= text "/cancel")
                                    (append intents (dict ("kind" "cancel") ("task_id" (map_get state "task_id"))))
                                    (append notices "A run is in progress. Type /cancel to stop it.")))
                                ((= text "")
                                  (append notices "Type an objective, or /help."))
                                ((starts_with text "/")
                                  (let (parts (str_split text " "))
                                    (let (cmd (list_get parts 0))
                                      (cond
                                        ((= cmd "/help")
                                          (do
                                            (append notices "Type an objective to preview its route. Commands:")
                                            (append notices "/agent ID | /agent auto   choose a provider or automatic selection")
                                            (append notices "/refresh   re-check configured AI resources")
                                            (append notices "/run       run the previewed objective (asks to confirm)")
                                            (append notices "/cancel    stop a running objective    /quit   leave")))
                                        ((= cmd "/quit")
                                          (append intents (dict ("kind" "quit"))))
                                        ((= cmd "/refresh")
                                          (append intents (dict ("kind" "inventory_refresh"))))
                                        ((= cmd "/cancel")
                                          (append notices "Nothing is running."))
                                        ((= cmd "/agent")
                                          (let (rid (if (> (list_len parts) 1) (list_get parts 1) ""))
                                           (do
                                            (cond
                                              ((or (= rid "") (= rid "auto"))
                                                (do
                                                  (map_set state "explicit_resource" (map_get (dict) "none"))
                                                  (append notices "Automatic provider selection.")))
                                              ((list_contains (map_get state "available") rid)
                                                (map_set state "explicit_resource" rid))
                                              (true
                                                (append notices (str_join (list "Provider " rid " is not currently usable; selection unchanged.") ""))))
                                            (when (not (is_nil (map_get state "objective")))
                                              (append intents (dict ("kind" "route_preview")
                                                                    ("objective" (map_get state "objective"))
                                                                    ("resource_id" (map_get state "explicit_resource"))))))))
                                        ((= cmd "/run")
                                          (cond
                                            ((is_nil (map_get state "objective"))
                                              (append notices "Type an objective first."))
                                            ((not (map_has state "route"))
                                              (append notices "Wait for the route preview first."))
                                            ((!= (map_get (map_get state "route") "status") "SELECTED")
                                              (append notices "The route is BLOCKED; nothing can run. Fix the exclusions or /refresh."))
                                            (true
                                              (set mode "confirm"))))
                                        (true
                                          (append notices (str_join (list "Unknown command " cmd ". Type /help.") "")))))))
                                (true
                                  (let (v (call core/validate_objective text (map_get config "max_objective_chars")))
                                    (if (map_get v "ok")
                                      (do
                                        (map_set state "objective" (map_get v "objective"))
                                        (map_delete state "route")
                                        (map_delete state "outcome")
                                        (append intents (dict ("kind" "route_preview")
                                                              ("objective" (map_get v "objective"))
                                                              ("resource_id" (map_get state "explicit_resource")))))
                                      (map_set state "failure" (dict ("source" "tui") ("code" (map_get v "code"))
                                                                     ("what" (map_get v "message"))
                                                                     ("why" "Input validation failed before any HowlPlane call.")
                                                                     ("next" "Edit the objective and submit again.")
                                                                     ("retry" "SAFE_TO_RETRY")))))))))
                          ((= kind "inventory")
                            (let (inv (call core/summarize_inventory (map_get event "document")))
                              (if (map_get inv "ok")
                                (let (lost (call core/lost_resources (map_get state "available") (map_get inv "rows")))
                                  (do
                                    (map_delete state "failure")
                                    (for x lost
                                      (do
                                        (append notices (str_join (list (map_get x "resource_id") " became unavailable: " (map_get x "readiness")) ""))
                                        (when (= (map_get state "explicit_resource") (map_get x "resource_id"))
                                          (do
                                            (map_set state "explicit_resource" (map_get (dict) "none"))
                                            (append notices "Explicit provider choice cleared; HowlPlane will select automatically.")))))
                                    (map_set state "rows" (map_get inv "rows"))
                                    (map_set state "available" (map_get inv "available"))
                                    (when (= (list_len (map_get inv "available")) 0)
                                      (append notices "No configured provider is currently usable."))))
                                (map_set state "failure" (dict ("source" "tui") ("code" (map_get inv "code"))
                                                               ("what" (map_get inv "message"))
                                                               ("why" "The inventory contract version is not one this TUI understands.")
                                                               ("next" "Upgrade the TUI or HowlPlane so their contract versions match.")
                                                               ("retry" "NEVER_AUTO_RETRY"))))))
                          ((= kind "route_preview")
                            (let (r (call core/summarize_route (map_get event "document") (map_get state "available")))
                              (if (map_get r "ok")
                                (do
                                  (map_delete state "failure")
                                  (map_set state "route" r)
                                  (when (= (map_get r "status") "SELECTED")
                                    (append notices "Type /run to run this objective, or edit it.")))
                                (map_set state "failure" (dict ("source" "tui") ("code" (map_get r "code"))
                                                               ("what" (map_get r "message"))
                                                               ("why" "The routing contract version is not one this TUI understands.")
                                                               ("next" "Upgrade the TUI or HowlPlane so their contract versions match.")
                                                               ("retry" "NEVER_AUTO_RETRY"))))))
                          ((= kind "run_started")
                            (do
                              (set mode "running")
                              (map_set state "task_id" (map_get event "task_id"))))
                          ((= kind "progress")
                            (let (p (call core/summarize_progress (map_get event "document")))
                              (when (map_get p "ok")
                                (do
                                  (map_set state "progress" p)
                                  ; Failover and provider failures are worth a line of their own.
                                  (when (not (is_nil (map_get p "message")))
                                    (append notices (str_join (list (to_string (map_get p "kind")) ": " (to_string (map_get p "message"))) "")))))))
                          ((= kind "failure")
                            (do
                              (when (map_get event "ends_run") (set mode "idle"))
                              (map_set state "failure" (call core/explain_failure (map_get event "document")))))
                          ((= kind "work_result")
                            (let (doc (map_get event "document"))
                              (do
                                (set mode "idle")
                                (map_set state "outcome" (dict ("final_state" (map_get doc "final_state"))
                                                               ("exit_code" (map_get doc "exit_code"))
                                                               ("next" (map_get (map_get doc "next_action") "reason"))
                                                               ("next_command" (map_get (map_get doc "next_action") "command"))
                                                               ("next_then" (map_get (map_get doc "next_action") "then"))
                                                               ("next_alternatives" (map_get (map_get doc "next_action") "alternatives"))
                                                               ("next_detail" (map_get (map_get doc "next_action") "detail"))
                                                               ("verification_status" (map_get (map_get doc "verification") "status")))))))
                          (true
                            (append notices (str_join (list "Ignored unknown event type: " (to_string kind)) ""))))
                        (map_set state "mode" mode)
                        (let (prompt "objective or /help > ")
                          (do
                            (map_set state "notices" notices)
                            (when (= mode "confirm")
                              (set prompt (str_join (list "Run with " (to_string (map_get (map_get state "route") "resource_id")) "? [y/N] ") "")))
                            (when (= mode "running")
                              (set prompt "running (/cancel) > "))
                            (print (encode_json (dict ("schema" "howlplane.tui_step_result/v1") ("ok" true)
                                                      ("state" state) ("intents" intents) ("prompt" prompt)
                                                      ("view" (call core/render state)))))))))))))))))))
